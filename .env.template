# .env.example - このファイルを .env にコピーし、実際の値を設定してください
# このファイルは、アプリケーションの様々な設定を管理するための環境変数定義の例です。
# .env という名前でこのファイルをコピーし、`your_..._here` となっている箇所を実際の値に置き換えて使用してください。
# 【重要】`.env` ファイル自体は Git にコミットしないでください。

---

# --- General ---
# サーバーの実行環境を指定します (開発時: development, 本番時: production)
NODE_ENV=development
# バックエンドAPIのポート番号（docker-compose.yml, server.js, nginx.conf と揃えること）
PORT=3100

# システム設定の暗号化キー（DBにAPIキーを保存・読み込みするすべての環境で必須）
# AES-256-GCMで使用する32バイト（256ビット）のBase64エンコードキーです。
# ★ 必須（OpenRouter APIキーをDBに保存する場合・保存済みのキーを読み込む場合）: 以下のコマンドで生成してください。
#   openssl rand -base64 32
SYSTEM_CONFIG_ENCRYPTION_KEY=generate_a_strong_32byte_base64_key_here

# JWT Settings (Required for Authentication)
JWT_SECRET=generate_a_strong_secret_key_here # e.g., use openssl rand -hex 32
JWT_EXPIRES_IN=1d                            # e.g., 1d, 7d, 30m
# パスワードハッシュのセキュリティを強化するペッパー値（docker-compose.quick.yml で使用）
PASSWORD_PEPPER=generate_a_strong_pepper_here # e.g., use openssl rand -hex 16

# Frontend API Base URLs (Accessible from the host machine/browser)
# Frontend が Backend API を呼び出す際の基本 URL です。
# Backend のルーター設定に合わせてパスを含める必要がある場合があります (例: /api)。
# Docker Compose 環境では通常 localhost:ポート番号 になります。

# Admin Backend の基本 URL です。
ADMIN_API_BASE_URL=http://localhost:3100
# Idea Backend の基本 URL です。
IDEA_FRONTEND_API_BASE_URL=http://localhost:3100
# Backend が静的ファイル（画像等）の公開URLを生成する際に使用するベースURLです。
# リバースプロキシ配下ではホスト名を含む公開URLを設定してください。
API_BASE_URL=http://localhost:3100

# CORS Settings for microservices
IDEA_CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Frontend アプリケーションが開発中にアクセスを許可するホストを指定します。
# 複数のホストを許可する場合、カンマ区切りで指定してください。
VITE_FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_ADMIN_FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB 接続設定
# Docker Compose を使用する場合はデフォルト値のままで動作します。
# 本番環境では認証付き URI（mongodb://user:pass@host:port/dbname）に変更してください。
MONGODB_URI=mongodb://mongo:27017/idea_discussion_db

# 企業研修用インスタンスの設定
# true にすると、トップページの意見の投稿者名を、参加者が表示名を設定していても常に「匿名ユーザー」にします。
# 少人数の研修で、表示名から意見の書き手が特定されることを防ぎます。市民向けの運用では false のままにします。
ANONYMIZE_AUTHOR_NAMES=false

# リバースプロキシ・レート制限の設定（idea-discussion/backend）
# リバースプロキシ（Caddy・nginx）の後ろで動かす場合は、信頼するプロキシの段数を指定します。
# 指定しないと、レート制限が全利用者をプロキシの IP 1つとして数えます。
# docker-compose.prod.yml（Caddy 経由）の既定値は 1 です。true は IP を詐称できるため指定できません。
# docker-compose.yml を `--profile with-nginx` で nginx 経由で使う場合も 1 を指定してください。
# backend のポートに直接アクセスさせる構成で指定すると、X-Forwarded-For で IP を詐称できるため、指定しないでください。
# Cloudflare のプロキシ（オレンジ雲）を Caddy の前に置く場合は、プロキシが2段になるため 2 を指定してください。
# TRUST_PROXY=1
# レート制限の上限値（正の整数）。上限を超えたリクエストには 429 を返します。
# 企業研修では参加者が同じグローバルIPからアクセスするため、IP ごとの上限は参加人数に合わせて調整してください。
# API 全体: IP ごと・1分あたりのリクエスト数
# RATE_LIMIT_API_PER_IP_PER_MINUTE=3000
# ログイン・初期管理者作成: IP ごと・15分あたりの失敗回数
# RATE_LIMIT_LOGIN_PER_IP_PER_15_MINUTES=10
# チャット送信: 参加者ごと・1分あたりの送信数
# RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=10
# チャット送信: IP ごと・1分あたりの送信数（同じIPの参加者全員の合計）
# RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=600
# 管理者専用の生成系API（論点生成・レポート生成・意見の取り込み・埋め込み・クラスタリング）: 管理者ごと・15分あたりの呼び出し数
# RATE_LIMIT_GENERATION_PER_ADMIN_PER_15_MINUTES=60
# 管理者の検索API（入力文の埋め込みに外部APIを呼ぶ）: 管理者ごと・15分あたりの呼び出し数（生成系とは別に数える）
# RATE_LIMIT_SEARCH_PER_ADMIN_PER_15_MINUTES=300
# 参加者の書き込み（表示名の変更・プロフィール画像・いいね）: 参加者ごと・1分あたりの書き込み数
# RATE_LIMIT_PARTICIPANT_WRITE_PER_USER_PER_MINUTE=30
